# TODO(aisha): create a form at https://formspree.io and paste its endpoint below.
# Every form on the site (ContactForm, DiagnosticForm) POSTs here. Until this is
# set to a real https://formspree.io/f/... URL, forms show the "message me on
# WhatsApp instead" fallback (see lib/forms.ts) rather than a false success message.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# TODO(aisha): setting this alone does NOT turn on analytics (IELTS Step 12) — see
# docs/launch-verification.md's "Analytics activation checklist". lib/analytics/config.ts's
# analyticsIsApproved() is hard-coded false until you've separately approved a provider, a
# privacy notice, a consent approach and a data-retention choice; that function must be changed
# by a deliberate, reviewed code edit before this ID (or any value here) has any effect. A public
# GA4 measurement ID starts with "G-" — see https://analytics.google.com. It's a public
# identifier, not a secret, but still isn't "on" just because it's set.
NEXT_PUBLIC_GA_ID=

# TODO(aisha): Microsoft Clarity (session recording) is intentionally NOT wired up anywhere in
# this codebase (IELTS Step 12, Part D) — it needs its own separate purpose, consent and
# data-minimisation decision beyond ordinary analytics. Setting this does nothing until that
# decision is made and the integration is actually built. See https://clarity.microsoft.com.
NEXT_PUBLIC_CLARITY_ID=

# TODO(aisha): the Meta Pixel is intentionally NOT wired up anywhere in this codebase either
# (IELTS Step 12, Part D) — same reasoning as Clarity above, plus advertising-specific consent
# requirements. Setting this does nothing until that decision is made and the integration is
# actually built. See https://business.facebook.com/events_manager.
NEXT_PUBLIC_META_PIXEL_ID=

# Enables a local-only console.debug of the (already-sanitised, allowlisted) analytics payload
# lib/analytics/track.ts would send — never active in a production build, and does not itself
# enable analytics. Useful only when developing/testing the event instrumentation locally.
NEXT_PUBLIC_ANALYTICS_DEBUG=
