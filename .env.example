# TODO(aisha): create a form at https://formspree.io and paste its endpoint below.
# Every form on the site (ContactForm, DiagnosticForm) POSTs here. Until this is
# set to a real https://formspree.io/f/... URL, forms show the "message me on
# WhatsApp instead" fallback (see lib/forms.ts) rather than a false success message.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# TODO(aisha): create a GA4 property at https://analytics.google.com and paste
# its Measurement ID (starts with "G-") below. Analytics won't load without it.
NEXT_PUBLIC_GA_ID=

# TODO(aisha): create a project at https://clarity.microsoft.com and paste its
# project ID below (Settings > Setup > Install tracking code > the ID in the
# script URL). Session recordings/heatmaps won't load without it.
NEXT_PUBLIC_CLARITY_ID=

# TODO(aisha): create a Meta Pixel at https://business.facebook.com/events_manager
# and paste its Pixel ID below. Needed before running any Meta/Instagram ads.
NEXT_PUBLIC_META_PIXEL_ID=
